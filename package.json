{
  "name": "honglou-writer",
  "version": "0.1.0",
  "description": "写作辅助工具库：章回、人物卡、时间线、伏笔追踪，附命令行工具 hlw",
  "keywords": [
    "writing",
    "novel",
    "chinese",
    "写作",
    "小说",
    "红楼梦"
  ],
  "homepage": "https://github.com/516014835/honglou-writer#readme",
  "bugs": {
    "url": "https://github.com/516014835/honglou-writer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/516014835/honglou-writer.git"
  },
  "license": "MIT",
  "author": "516014835",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hlw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
